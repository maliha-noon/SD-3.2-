# AURA++ — Environment Variables Template
# Copy this to .env and fill in real values before running Docker.
# NEVER commit the real .env file to source control.

# ── MySQL (only needed for --profile mysql) ───────────────────
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=aura_db

# ── App environment ───────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production

# ── Optional: Override connection strings via env ─────────────
# ConnectionStrings__DefaultConnection=Server=mysql_db;Database=aura_db;User=root;Password=rootpassword;
# ConnectionStrings__SqliteConnection=Data Source=/app/data/aura.db
